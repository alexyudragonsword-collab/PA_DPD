/* padpd desktop dark engineering theme */
* { font-family: "Segoe UI", "Noto Sans CJK SC", sans-serif; font-size: 13px; }

QMainWindow, QWidget { background: #0e1320; color: #e7eaf2; }

/* navigation sidebar */
QListWidget#nav {
  background: #0a0e18; border: none; padding-top: 8px;
  min-width: 168px; max-width: 168px; font-size: 13.5px;
}
QListWidget#nav::item { padding: 10px 16px; border-radius: 8px; margin: 2px 8px; }
QListWidget#nav::item:selected { background: #22304d; color: #ffffff; }
QListWidget#nav::item:hover:!selected { background: #161e30; }

QLabel#brand { font-size: 15px; font-weight: 700; padding: 14px 16px 0 16px; }
QLabel#brandSub { color: #8a94ad; font-size: 11px; padding: 0 16px 10px 16px; }

QLabel#pageTitle { font-size: 19px; font-weight: 700; padding: 4px 0; }
QLabel#note {
  background: #131a2a; border-left: 3px solid #4f8ff7; border-radius: 5px;
  color: #aeb7cc; padding: 8px 12px; font-size: 12px;
}

/* metric cards */
QFrame.card {
  background: #171e2e; border: 1px solid #26304a; border-radius: 10px;
}
QLabel.cardLabel { color: #9aa4bd; font-size: 11.5px; }
QLabel.cardValue { font-size: 21px; font-weight: 700; }
QLabel.cardDelta { color: #37c978; font-size: 11px; }

/* controls */
QPushButton {
  background: #22304d; border: 1px solid #31426a; border-radius: 7px;
  padding: 7px 16px;
}
QPushButton:hover { background: #2a3a5e; }
QPushButton#primary { background: #e4574c; border-color: #e4574c; color: white; font-weight: 600; }
QPushButton#primary:hover { background: #ef685d; }
QPushButton:disabled { background: #1a2130; color: #5a6478; border-color: #26304a; }

QComboBox, QSpinBox, QDoubleSpinBox, QLineEdit {
  background: #171e2e; border: 1px solid #26304a; border-radius: 6px;
  padding: 5px 8px; selection-background-color: #22304d;
}
QComboBox QAbstractItemView { background: #171e2e; border: 1px solid #26304a; }

QGroupBox {
  border: 1px solid #26304a; border-radius: 9px; margin-top: 12px;
  padding-top: 6px; font-weight: 600;
}
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 4px; color: #9aa4bd; }

QTabWidget::pane { border: 1px solid #26304a; border-radius: 8px; top: -1px; }
QTabBar::tab {
  background: transparent; padding: 7px 16px; color: #9aa4bd;
  border-bottom: 2px solid transparent;
}
QTabBar::tab:selected { color: #e7eaf2; border-bottom: 2px solid #e4574c; }

QTableWidget {
  background: #121828; border: 1px solid #26304a; border-radius: 8px;
  gridline-color: #232c42; alternate-background-color: #151c2d;
}
QHeaderView::section {
  background: #171e2e; border: none; padding: 6px; color: #9aa4bd;
  border-bottom: 1px solid #26304a;
}

QProgressBar {
  background: #171e2e; border: 1px solid #26304a; border-radius: 7px;
  text-align: center; height: 16px;
}
QProgressBar::chunk { background: #e4574c; border-radius: 6px; }

QScrollArea { border: none; }
QSlider::groove:horizontal { height: 4px; background: #26304a; border-radius: 2px; }
QSlider::handle:horizontal {
  width: 14px; height: 14px; margin: -6px 0; border-radius: 7px; background: #e4574c;
}
